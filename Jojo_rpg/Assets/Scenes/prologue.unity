  m_Script: {fileID: 11500000, guid: edd23f5547246c3408d8cdb2cd1015f3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  Narrator1:
  - 'Once upon a time. London was a beautiful city filled with life. '
  - 'Children roamed the streets and people lived a happy life '
  - The world was truly at peace!
  - That was until...
  - Malakith attacked!!
  Narrator2:
  - The city was set ablaze!!!
  - The farmers died and turned into undead monsters
  - The few that survived became slaves.
  - all except for one child
  Narrator3:
  - Scared and alone
  - The child ran into the forrest
  Narrator4:
  - To escape from this hellish reality
  - There was only one thought on the child's mind
  - SURVIVE!
  ON_THIS: 0
  GOOD_TOWN: {fileID: 3773522769883482900}
  Destroyed_town: {fileID: 46569422}
