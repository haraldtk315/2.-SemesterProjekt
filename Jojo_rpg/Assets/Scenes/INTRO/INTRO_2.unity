  m_Script: {fileID: 11500000, guid: 76f17372304b0d8468a04722381085c5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  HAS_ICON: 1
  TRANSFER_TO_THIS: INTRO_3
  New_player_cords: {x: 0, y: 0, z: 0}
  FADE: {fileID: 9126982459725653670, guid: c6071e8c84687874b8e7ddf64276c2a7, type: 3}
  DisplayText_on_fade: 5 Years later...
  npcID: Last_frog
  message:
  - 'Frog: It seems like you are awake!'
  - 'I tended your wounds little child. *Ribbit* '
  - The world is not safe anymore...
  - The balance of power has shifted, little child...
  - The world truly more than ever needs a hero.
  - You problably do not expect this of little old me.
  - But I am a master among few in the anciet art of Lediha.
  - My people learned to harness an organism's latent powers.
  - I can teach you little child.
  - So that you can protect the people you love. *Ribbit*
  - I sense the passion for justice within your being.
  - However, in order to master Lediha you'll need immense focus.
  - Do you think you have what it takes?
  - LET YOUR TRAINING BEGIN!
  messageAfterBattle: []
  enemies:
  - {fileID: 380776666666102203, guid: b819f22bbc9e0bc4caaebd9d5cb10754, type: 3}
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
